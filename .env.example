# Copy to .env (or run `python studio.py setup`, which writes it for you). Never commit .env.

# Required: voice, sound effects and music
ELEVENLABS_API_KEY=

# Mascot poses and transition clips: google or higgsfield
MEDIA_PROVIDER=google

# google: one Gemini API key (https://aistudio.google.com/apikey) covers Nano Banana images and Veo video
GEMINI_API_KEY=
# optional model overrides
# GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
# GOOGLE_VIDEO_MODEL=veo-3.1-fast-generate-preview

# higgsfield: no key here. `python studio.py setup` installs the official Higgsfield CLI and signs you in
# in the browser (Higgsfield's API keys can't upload a local mascot image; the CLI can).
